# Copie este arquivo para .env e defina uma senha local forte.
POSTGRES_PASSWORD=

# Gere um valor local com: openssl rand -base64 32
# Nunca use a mesma chave entre ambientes nem versione o valor gerado.
JWT_SECRET_BASE64=

# Opcional: lista de origens do frontend separadas por virgula.
CORS_ALLOWED_ORIGINS=

# Desative em ambientes que nao devem publicar Swagger UI/OpenAPI.
OPENAPI_ENABLED=true
